[INGEST:vendor="%%VENDOR%%", product="%%PRODUCT%%", target_dataset="%%DATASET%%", no_hit=keep]
// Parsing rule scaffold generated by spellbook summon template parsing_modeling.
// Replace the body below with extraction logic appropriate to the source events.
//
// The default body is intentionally a no-op pass-through: events are forwarded
// to %%DATASET%% with their _raw_log preserved so that the paired modeling
// rule can be developed against real samples before the parser is fleshed out.
filter _raw_log != null
| alter _time = current_time();
