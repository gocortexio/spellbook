[MODEL: dataset=%%DATASET%%]
// Modeling rule scaffold generated by spellbook summon template parsing_modeling.
// Map fields produced by the paired %%VENDOR%% %%PRODUCT%% Parsing Rule to XDM
// here. The schema file alongside this rule declares the raw column types that
// the modeler validates against.
alter
    xdm.event.type = to_string(event_type),
    xdm.observer.vendor = "%%VENDOR%%",
    xdm.observer.product = "%%PRODUCT%%";
